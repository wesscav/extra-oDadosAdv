# OpenAI API Key (obrigatório para análise de documentos)
OPENAI_API_KEY=sk-proj-...

# Firebase Admin SDK (obrigatório para autenticação)
# Opção 1: Caminho para o arquivo serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=C:\caminho\para\serviceAccountKey.json

# Opção 2: JSON string completo do service account (escape as aspas)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"horlandobraga-168fc",...}

# Opção 3: Google Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\para\serviceAccountKey.json

# Variáveis opcionais do Firebase
FIREBASE_PROJECT_ID=horlandobraga-168fc
# FIREBASE_CHECK_REVOKED=1

# Tesseract OCR (Windows)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Poppler (para pdf2image no Windows)
# POPPLER_PATH=C:\caminho\para\poppler\bin
